/* =====================================================================
   七、导出 CSV
   ===================================================================== */
function csvCell(v){
  const s = String(v == null ? '' : v);
  return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
}
function downloadCSV(rows, filename){
  const csv = '\ufeff' + rows.map(r => r.map(csvCell).join(',')).join('\r\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  toast('已导出：' + filename);
}
function exportAll(){
  if(!REG.length) return toast('暂无可导出的数据');
  const rows = [['班级','中文姓名','英文名','家长手机号','已选课程','选课数','提交时间']];
  REG.slice().sort((a, b) => String(a.cls).localeCompare(String(b.cls))).forEach(r => {
    const names = (r.picks || []).map(id => {
      const s = sessionById(id) || {name:id, period:''};
      return s.period + ' ' + s.name;
    });
    rows.push([r.cls, r.cn, r.en || '', r.phone || '', names.join(' / '), names.length, fmtTime(r.ts)]);
  });
  const d = new Date().toISOString().slice(0, 10);
  downloadCSV(rows, '开放日选课名单_' + d + '.csv');
}
function exportBySession(){
  if(!REG.length) return toast('暂无可导出的数据');
  const rows = [['时段','课程','教师','教室','容量','已报人数','家长名单']];
  SESSIONS.forEach(s => {
    const bs = REG.filter(r => (r.picks || []).includes(s.id));
    rows.push([s.period, s.name, s.teacher, s.room, CAPACITY, bs.length,
      bs.map(b => b.cn + '(' + b.cls + '班' + (b.phone ? ' ' + b.phone : '') + ')').join('、')]);
  });
  const d = new Date().toISOString().slice(0, 10);
  downloadCSV(rows, '开放日各课堂名单_' + d + '.csv');
}

/* =====================================================================
   八、通用确认弹窗
   ===================================================================== */
function confirmBox({title, desc, okText = '确认', danger = false, needText, inputPlaceholder, onOk}){
  const root = $('#modalRoot');
  root.innerHTML = `
  <div class="mask">
    <div class="modal">
      <h3>${esc(title)}</h3>
      <p>${esc(desc).replace(/\n/g, '<br>')}</p>
      ${needText ? `<input id="mbox" placeholder="${esc(inputPlaceholder || '')}">` : ''}
      <div class="btns">
        <button class="cancel" onclick="closeModal()">取消</button>
        <button class="ok ${danger ? 'danger' : ''}" id="mok" ${needText ? 'disabled' : ''}>${esc(okText)}</button>
      </div>
    </div>
  </div>`;
  const ok = $('#mok'), inp = $('#mbox');
  if(needText && inp){
    inp.addEventListener('input', () => { ok.disabled = inp.value.trim() !== needText; });
    setTimeout(() => inp.focus(), 50);
  }
  ok.addEventListener('click', () => { const cb = ok._cb; closeModal(); cb && cb(); });
  ok._cb = onOk;
}
function closeModal(){ $('#modalRoot').innerHTML = ''; }

/* =====================================================================
   九、启动
   ===================================================================== */
document.querySelectorAll('.tab').forEach(el => el.addEventListener('click', () => {
  tab = el.dataset.tab;
  document.querySelectorAll('.tab').forEach(x => x.classList.toggle('active', x === el));
  if(tab === 'admin') refresh();
  render();
}));

paintLive();
render();
startRealtime();
</script>
</body>
</html>
