<script>
/* =====================================================================
   一、配置区
   ===================================================================== */
const DB_URL = 'https://vkbs-2026-g6-open-day-default-rtdb.asia-southeast1.firebasedatabase.app';
const DB_PATH = '/registrations';           // 数据根节点
const ADMIN_USER = 'admin';                 // 管理员账号
const ADMIN_PASS = 'vkbsms123';             // 管理员密码

const CAPACITY = 8;   // 每节课限 8 名家长
const MAX_PICK = 2;   // 每位家长限选 2 节

const PERIODS = ['P1','P2','P3','P4'];
const PERIOD_NAME = {P1:'第 1 节课', P2:'第 2 节课', P3:'第 3 节课', P4:'第 4 节课'};
const CLASSES = ['6-1','6-2','6-3','6-4','6-5'];
const ENG_LEVELS = ['H','S1','S','ESL'];

/* 课表数据（来源：家长开放日课表截图）
 * type : 'eng' 英语 | 'math' 数学 | 'cls' 班级课
 * level: 该课堂对应的层次（用于展示，课名中已体现）
 * grp  : 英语/数学课堂开放给哪些班级（按课表分组，非全年级混班）
 * cls  : 班级课所属班级
 * room : "TBD" = 原表 "find a bigger room than G20"
 */
const SESSIONS = [
  // ---------- P1 ----------
  {id:'e1', period:'P1', type:'eng', name:'英语 · H 层 (A)',  level:'H',   teacher:'Arné Engelbrecht', room:'TBD（大于G20的教室）', grp:['6-1','6-2','6-3']},
  {id:'e2', period:'P1', type:'eng', name:'英语 · S1 层 (A)', level:'S1',  teacher:'Sarah Harkin',      room:'208', grp:['6-1','6-2','6-3']},
  {id:'e3', period:'P1', type:'eng', name:'英语 · S1 层 (B)', level:'S1',  teacher:'Lauren Berry',      room:'207', grp:['6-1','6-2','6-3']},
  {id:'e4', period:'P1', type:'eng', name:'英语 · ESL 层 (A)',level:'ESL', teacher:'Calum Carey',       room:'206', grp:['6-1','6-2','6-3']},
  {id:'m1', period:'P1', type:'math', name:'数学 Math', level:'何春莉老师组', teacher:'何春莉 Ms. Cathy He', room:'209', grp:['6-4','6-5']},
  {id:'m2', period:'P1', type:'math', name:'数学 Math', level:'涂恋恋老师组', teacher:'涂恋恋 Ms. Tu',       room:'210', grp:['6-4','6-5']},
  // ---------- P2 ----------
  {id:'m3', period:'P2', type:'math', name:'数学 Math', level:'秦秦睿老师组', teacher:'秦秦睿 Ms. Katie Qin', room:'206', grp:['6-1','6-2','6-3']},
  {id:'m4', period:'P2', type:'math', name:'数学 Math', level:'白文炜老师组', teacher:'白文炜 Ms. Bai',       room:'207', grp:['6-1','6-2','6-3']},
  {id:'m5', period:'P2', type:'math', name:'数学 Math', level:'涂恋恋老师组', teacher:'涂恋恋 Ms. Tu',        room:'208', grp:['6-1','6-2','6-3']},
  {id:'g1', period:'P2', type:'cls', name:'G-Science', teacher:'James Stewart', room:'209', cls:'6-4'},
  {id:'g2', period:'P2', type:'cls', name:'G-Science', teacher:'Mr.P',          room:'210', cls:'6-5'},
  // ---------- P3 ----------
  {id:'c11', period:'P3', type:'cls', name:'语文 Chinese', teacher:'汪颖 Ms. Wang Ying', room:'206', cls:'6-1'},
  {id:'c21', period:'P3', type:'cls', name:'CCE',          teacher:'Mohammed Tenil',    room:'207', cls:'6-2'},
  {id:'c31', period:'P3', type:'cls', name:'赛艇 Rowing',  teacher:'赛艇教练团队',        room:'户外·码头', cls:'6-3'},
  {id:'c41', period:'P3', type:'cls', name:'STEM',         teacher:'Miguel Carrasquel', room:'STEM Room', cls:'6-4'},
  {id:'c51', period:'P3', type:'cls', name:'语文 Chinese', teacher:'顾江溪 Ms. Gu',      room:'210', cls:'6-5'},
  // ---------- P4 ----------
  {id:'c12', period:'P4', type:'cls', name:'体育 PE',      teacher:'高亚飞',             room:'操场', cls:'6-1'},
  {id:'c22', period:'P4', type:'cls', name:'STEM',         teacher:'Miguel Carrasquel', room:'STEM Room', cls:'6-2'},
  {id:'c32', period:'P4', type:'cls', name:'语文 Chinese', teacher:'曹丽妮 Ms. Cao',     room:'208', cls:'6-3'},
  {id:'e5', period:'P4', type:'eng', name:'英语 · H 层 (B)',   level:'H',   teacher:'Arné Engelbrecht', room:'TBD（大于G20的教室）', grp:['6-4','6-5']},
  {id:'e6', period:'P4', type:'eng', name:'英语 · S 层 (C)',   level:'S',   teacher:'Sarah Harkin',     room:'210', grp:['6-4','6-5']},
  {id:'e7', period:'P4', type:'eng', name:'英语 · ESL 层 (B)', level:'ESL', teacher:'Calum Carey',      room:'209', grp:['6-4','6-5']},
];
const sessionById = id => SESSIONS.find(s => s.id === id);

/* =====================================================================
   二、云端数据库（Firebase Realtime Database REST）
   ===================================================================== */
const LS = {
  get(k, d){ try{ return JSON.parse(localStorage.getItem(k)) ?? d; }catch(e){ return d; } },
  set(k, v){ localStorage.setItem(k, JSON.stringify(v)); },
  del(k){ localStorage.removeItem(k); }
};
const K_ME = 'vkbs_g6_me', K_PICKS = 'vkbs_g6_picks', K_KEY = 'vkbs_g6_key';

let REG = [];            // 全部登记记录 [{key, cls, cn, en, phone, picks, ts}]
let dbState = 'connecting'; // connecting | live | error | denied

async function api(method, path, body){
  const opt = { method, headers:{ 'Content-Type':'application/json' } };
  if(body !== undefined) opt.body = JSON.stringify(body);
  const res = await fetch(DB_URL + path + '.json', opt);
  if(res.status === 401 || res.status === 403){
    dbState = 'denied'; paintLive();
    throw new Error('数据库拒绝了本次操作（权限不足）');
  }
  if(!res.ok){ dbState = 'error'; paintLive(); throw new Error('网络请求失败（HTTP ' + res.status + '）'); }
  dbState = 'live'; paintLive();
  const txt = await res.text();
  return txt ? JSON.parse(txt) : null;
}
const fetchAll  = () => api('GET', DB_PATH);
const pushRec   = (rec) => api('POST', DB_PATH, rec);
const putRec    = (key, rec) => api('PUT', DB_PATH + '/' + key, rec);
const deleteRec = (key) => api('DELETE', DB_PATH + '/' + key);
const deleteAll = () => api('DELETE', DB_PATH);

function applyRemote(data){
  REG = Object.entries(data || {}).map(([key, v]) => Object.assign({key}, v));
  render();
}
async function refresh(){
  try{ applyRemote(await fetchAll()); }
  catch(e){ /* 状态已由 api() 记录 */ }
}
/* 实时推送：Firebase REST 的 SSE 流（失败自动降级为轮询） */
function startRealtime(){
  paintLive();
  if(window.EventSource){
    try{
      const es = new EventSource(DB_URL + DB_PATH + '.json');
      es.addEventListener('put', e => {
        const m = JSON.parse(e.data);
        if(m.path === '/'){ applyRemote(m.data); }
        else if(m.data === null){ // 某条被删除
          const k = m.path.slice(1).split('/')[0];
          REG = REG.filter(r => r.key !== k); render();
        }else if(m.data){        // 新增/更新某条
          const k = m.path.slice(1).split('/')[0];
          const i = REG.findIndex(r => r.key === k);
          const rec = Object.assign({key:k}, m.data);
          if(i > -1) REG[i] = rec; else REG.push(rec);
          render();
        }
        dbState = 'live'; paintLive();
      });
      es.onerror = () => { es.close(); };
    }catch(e){}
  }
  refresh();
  setInterval(refresh, 20000);   // 兜底轮询
  document.addEventListener('visibilitychange', () => { if(!document.hidden) refresh(); });
}
function paintLive(){
  const dot = $('#liveDot'), txt = $('#liveTxt');
  if(!dot) return;
  if(dbState === 'live'){ dot.className = 'dot'; txt.textContent = '实时同步中'; }
  else if(dbState === 'denied'){ dot.className = 'dot off'; txt.textContent = '数据库无权限'; }
  else if(dbState === 'error'){ dot.className = 'dot off'; txt.textContent = '连接异常'; }
  else { txt.textContent = '连接中'; }
}

/* =====================================================================
   三、页面状态
   ===================================================================== */
let me    = LS.get(K_ME, null);      // {cls, cn, en, phone}
let picks = LS.get(K_PICKS, []);     // ['e2','c11']
let myKey = LS.get(K_KEY, null);     // 已提交记录在数据库中的 key
let tab   = 'pick';                  // pick | me | admin
let editing = false;                 // 是否处于「修改已提交选课」状态
let adminIn = sessionStorage.getItem('vkbs_g6_admin') === '1';

const $  = s => document.querySelector(s);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtTime = ts => ts ? new Date(ts).toLocaleString('zh-CN', {hour12:false}) : '';
function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.style.display = 'block';
  clearTimeout(t._h); t._h = setTimeout(() => t.style.display = 'none', 2000);
}
/* 统计 */
const takenCount = id => REG.filter(r => (r.picks || []).includes(id)).length;
const seatsLeft  = id => Math.max(0, CAPACITY - takenCount(id));
const myRecord   = () => REG.find(r => r.key === myKey) || null;

/* =====================================================================
   四、选课资格（按课表分组）
   ===================================================================== */
function checkEligible(s, cls){
  if(s.type === 'cls') return s.cls === cls ? '' : '仅限 ' + s.cls + ' 班';
  return (s.grp || []).includes(cls) ? '' : '该课堂不对 ' + cls + ' 班开放';
}

/* =====================================================================
   五、渲染
   ===================================================================== */
function render(){
  const badge = $('#meBadge');
  const n = myRecord() ? (myRecord().picks || []).length : (me ? picks.length : 0);
  badge.style.display = n ? 'block' : 'none'; badge.textContent = n;

  if(tab === 'me')         return renderMe();
  if(tab === 'admin')      return renderAdmin();
  if(!me)                  return renderForm();
  return renderPick();
}

