/* ---------- 选课 ---------- */
function renderPick(){
  const rec = myRecord();
  const useLocal = !rec || editing;                 // 已提交且未点「修改」时，展示云端记录
  const chosen = useLocal ? picks : (rec.picks || []);
  const chosenPeriods = chosen.map(id => (sessionById(id) || {}).period);
  let html = '';

  if(dbState === 'denied'){
    html += `<div class="banner">⚠️ 数据库读写被拒绝。请在 Firebase 控制台 → Realtime Database → 规则 中允许读写，例如：<br><code>{"rules":{".read":true,".write":true}}</code></div>`;
  }else if(dbState === 'error'){
    html += `<div class="banner warn">⚠️ 云端连接异常，名额可能不是最新的，请稍后重试。</div>`;
  }
  if(rec && !editing){
    html += `<div class="banner ok">✅ 您已于 ${fmtTime(rec.ts)} 提交选课。如需调整，请到「我的」页点击「修改我的选课」。</div>`;
  }else if(editing){
    html += `<div class="banner warn">✏️ 正在修改已提交的选课，重新提交后将覆盖原记录。</div>`;
  }

  PERIODS.forEach(pd => {
    if(pd === 'P3') html += '<div class="break-line">— · 课间休息 Break · —</div>';
    const chosenHere = chosenPeriods.includes(pd);
    html += `<div class="period-head"><span class="period-tag">${pd}</span>
      <span class="period-name">${PERIOD_NAME[pd]}</span>
      <span class="period-note">${chosenHere ? '✔ 本时段已选' : ''}</span></div>`;

    SESSIONS.filter(s => s.period === pd).forEach(s => {
      const left = seatsLeft(s.id), full = left <= 0;
      const picked = chosen.includes(s.id);
      const reason = picked ? '' : checkEligible(s, me.cls);
      const fullUp = !picked && useLocal && chosen.length >= MAX_PICK;
      const conflict = !picked && chosenHere && useLocal;
      const dis = !picked && (full || reason || fullUp || conflict);
      let btn;
      if(picked)        btn = `<button class="btn btn-cancel" onclick="unpick('${s.id}')">退选</button>`;
      else if(dis){
        const r = full ? '已满员' : (fullUp ? '已达 2 节上限' : (conflict ? '时段冲突' : reason));
        btn = `<span class="reason">${r}</span><button class="btn btn-off" disabled>选课</button>`;
      }else             btn = `<button class="btn btn-pick" onclick="pick('${s.id}')">选课</button>`;

      const tag = s.type === 'eng'  ? `<span class="tag eng">英语 · ${s.level}</span>`
                : s.type === 'math' ? `<span class="tag math">数学 · ${s.level}</span>`
                : `<span class="tag cls">${s.cls} 班</span>`;
      const scope = s.type === 'cls' ? `限 ${s.cls} 班` : `面向 ${(s.grp || []).join(' / ')} 班`;
      html += `
      <div class="course ${picked ? 'selected' : ''} ${dis ? 'disabled' : ''}">
        <div class="top"><span class="subject">${esc(s.name)}</span>${tag}${full ? '<span class="tag full">已满</span>' : ''}</div>
        <div class="meta">👨‍🏫 ${esc(s.teacher)} ｜ 📍 ${esc(s.room)}<br>🏫 ${scope}</div>
        <div class="foot"><span class="seat">剩余名额 <b>${left}</b> / ${CAPACITY}</span>${btn}</div>
      </div>`;
    });
  });
  $('#content').innerHTML = html;

  // 提交条
  if(rec && !editing){
    $('#submitbar').innerHTML = `
    <div class="txt">已提交 <b>${chosen.length}</b> 节课<br>${chosen.map(id => esc((sessionById(id) || {}).name)).join('、')}</div>
    <button class="btn-main" style="background:#c8d3de" onclick="goPick()">修改选课</button>`;
  }else{
    $('#submitbar').innerHTML = `
    <div class="txt">已选 <b>${picks.length}</b> / ${MAX_PICK} 节<br>${picks.length ? picks.map(id => esc((sessionById(id) || {}).name)).join('、') : '请选择 1–2 节课'}</div>
    <button class="btn-main" ${picks.length ? '' : 'disabled'} onclick="submitPicks(this)">${editing ? '重新提交' : '提交选课'}</button>`;
  }
}

function pick(id){
  const s = sessionById(id); if(!s) return;
  if(picks.length >= MAX_PICK) return toast('每位家长最多选 ' + MAX_PICK + ' 节课');
  if(picks.some(p => sessionById(p).period === s.period)) return toast('与已选课程时段冲突（' + PERIOD_NAME[s.period] + '）');
  const r = checkEligible(s, me.cls); if(r) return toast('无法选择：' + r);
  if(seatsLeft(id) <= 0) return toast('该课堂名额已满');
  picks.push(id); LS.set(K_PICKS, picks); render();
}
function unpick(id){
  picks = picks.filter(p => p !== id); LS.set(K_PICKS, picks); render();
}

/* ---------- 提交到云端 ---------- */
async function submitPicks(btn){
  if(!me) return renderForm();
  if(!picks.length) return toast('请至少选择 1 节课');
  if(btn){ btn.disabled = true; btn.textContent = '提交中…'; }

  try{
    await refresh();   // 取最新名额
    for(const id of picks){
      if(seatsLeft(id) <= 0) throw new Error('「' + sessionById(id).name + '」刚刚已满员，请重新选择');
    }
    const dup = REG.find(r => r.key !== myKey && (r.phone === me.phone || (r.cls === me.cls && r.cn === me.cn)));
    if(dup) throw new Error('该学生已由家长提交过选课（' + dup.phone + '），每个家庭限 1 名家长');

    const rec = {cls: me.cls, cn: me.cn, en: me.en || '', phone: me.phone, picks: picks.slice(), ts: Date.now()};
    if(myKey){
      await putRec(myKey, rec);                       // 修改：覆盖自己的记录
    }else{
      const r = await pushRec(rec);                   // 首次：新增记录
      if(r && r.name){ myKey = r.name; LS.set(K_KEY, myKey); }
    }
    toast('提交成功 ✔');
    editing = false;
    await refresh();
    tab = 'me'; document.querySelectorAll('.tab').forEach(el => el.classList.toggle('active', el.dataset.tab === 'me'));
    render();
  }catch(e){
    toast(e.message || '提交失败，请稍后重试');
    if(btn){ btn.disabled = false; btn.textContent = '提交选课'; }
  }
}

