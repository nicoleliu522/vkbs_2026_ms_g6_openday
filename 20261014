<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>万科双语学校 · 六年级开放日选课</title>
<style>
  :root{
    --primary:#3a6ea5; --primary-dark:#2c5580; --primary-light:#e8f1fa;
    --green:#3a9e6e; --green-light:#e6f5ee;
    --orange:#e8833a; --orange-light:#fdf0e5;
    --red:#d9534f; --red-light:#fbeaea;
    --text:#333; --text-sub:#888; --line:#eee; --bg:#f4f6f8; --card:#fff;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);padding-bottom:76px}
  .page{max-width:480px;margin:0 auto;min-height:100vh}

  /* 顶部 */
  .header{background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;padding:22px 18px 18px;border-radius:0 0 18px 18px;position:relative}
  .header h1{font-size:19px;font-weight:600;letter-spacing:.5px}
  .header .sub{font-size:12px;opacity:.85;margin-top:6px}
  .header .rule{margin-top:10px;background:rgba(255,255,255,.14);border-radius:10px;padding:8px 10px;font-size:11.5px;line-height:1.7}
  .live{position:absolute;right:16px;top:20px;font-size:10.5px;background:rgba(255,255,255,.18);border-radius:10px;padding:3px 8px;display:flex;align-items:center;gap:4px}
  .dot{width:6px;height:6px;border-radius:50%;background:#7ef0a8;box-shadow:0 0 0 0 rgba(126,240,168,.8);animation:pulse 1.8s infinite}
  .dot.off{background:#ffc9c5;animation:none}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(126,240,168,.7)}70%{box-shadow:0 0 0 7px rgba(126,240,168,0)}100%{box-shadow:0 0 0 0 rgba(126,240,168,0)}}

  /* 底部标签栏 */
  .tabbar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:#fff;border-top:1px solid var(--line);display:flex;z-index:60}
  .tabbar .tab{flex:1;text-align:center;padding:9px 0 8px;font-size:11px;color:#999;cursor:pointer;position:relative}
  .tabbar .tab .ico{font-size:20px;display:block;margin-bottom:2px}
  .tabbar .tab.active{color:var(--primary)}
  .tabbar .tab .badge{position:absolute;top:4px;right:calc(50% - 26px);background:var(--red);color:#fff;font-size:10px;min-width:16px;height:16px;line-height:16px;border-radius:8px;padding:0 4px}

  .content{padding:14px 14px 20px}
  .card{background:var(--card);border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 1px 4px rgba(0,0,0,.05)}
  .banner{background:var(--red-light);color:#b83b37;border-radius:10px;padding:10px 12px;font-size:12px;line-height:1.7;margin-bottom:12px}
  .banner.ok{background:var(--green-light);color:#2f8a5f}
  .banner.warn{background:var(--orange-light);color:#b06a1c}

  /* 时段 */
  .period-head{display:flex;align-items:center;gap:8px;margin:16px 2px 8px}
  .period-tag{background:var(--primary);color:#fff;font-size:12px;font-weight:600;border-radius:6px;padding:3px 8px}
  .period-name{font-size:14px;font-weight:600;color:#555}
  .period-note{font-size:11px;color:var(--text-sub);margin-left:auto}
  .break-line{text-align:center;color:#bbb;font-size:11px;margin:12px 0;letter-spacing:2px}

  /* 课程卡片 */
  .course{border:1px solid var(--line);border-radius:12px;padding:11px 12px;margin-bottom:9px;background:#fff;transition:.2s}
  .course.selected{border-color:var(--green);background:var(--green-light)}
  .course.disabled{opacity:.55;background:#fafafa}
  .course .top{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
  .subject{font-size:15px;font-weight:600}
  .tag{font-size:10px;border-radius:4px;padding:2px 6px;font-weight:500}
  .tag.eng{background:#e3ecfb;color:#3a6ea5}
  .tag.math{background:#fdf0e5;color:#c96a1d}
  .tag.cls{background:#e6f5ee;color:#2f8a5f}
  .tag.full{background:var(--red-light);color:var(--red)}
  .course .meta{font-size:12px;color:var(--text-sub);margin-top:5px;line-height:1.6}
  .course .foot{display:flex;align-items:center;margin-top:9px}
  .seat{font-size:11.5px;color:var(--text-sub)}
  .seat b{color:var(--orange)}
  .btn{margin-left:auto;border:none;border-radius:16px;padding:6px 16px;font-size:12.5px;cursor:pointer;font-weight:500;font-family:inherit}
  .btn-pick{background:var(--primary);color:#fff}
  .btn-pick:active{background:var(--primary-dark)}
  .btn-cancel{background:#fff;color:var(--green);border:1px solid var(--green)}
  .btn-off{background:#e5e5e5;color:#999;cursor:not-allowed}
  .reason{font-size:11px;color:var(--red);margin-left:auto}

  /* 表单 */
  .form-item{margin-bottom:13px}
  .form-item label{display:block;font-size:13px;color:#555;margin-bottom:6px;font-weight:500}
  .form-item label .req{color:var(--red);margin-left:2px}
  .form-item label .opt{color:#aaa;font-size:11px;font-weight:400;margin-left:4px}
  .form-item input,.form-item select{width:100%;border:1px solid #ddd;border-radius:9px;padding:10px 12px;font-size:14px;background:#fafbfc;outline:none;font-family:inherit}
  .form-item input:focus,.form-item select:focus{border-color:var(--primary);background:#fff}
  .tip{font-size:11px;color:var(--text-sub);margin-top:4px;line-height:1.6}
  .btn-main{width:100%;border:none;border-radius:22px;padding:12px;font-size:15px;font-weight:600;background:var(--primary);color:#fff;cursor:pointer;margin-top:4px;font-family:inherit}
  .btn-main:active{background:var(--primary-dark)}
  .btn-main[disabled]{background:#c8d3de;cursor:not-allowed}
  .btn-ghost{width:100%;border:1px solid #ddd;border-radius:22px;padding:10px;font-size:13px;background:#fff;color:#777;cursor:pointer;margin-top:10px;font-family:inherit}

  /* 我的 */
  .me-head{display:flex;align-items:center;gap:12px}
  .avatar{width:46px;height:46px;border-radius:50%;background:var(--primary-light);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
  .me-info .name{font-size:16px;font-weight:600}
  .me-info .cls{font-size:12px;color:var(--text-sub);margin-top:3px}
  .lvl{display:inline-block;font-size:10.5px;background:var(--orange-light);color:var(--orange);border-radius:4px;padding:2px 6px;margin-right:4px;margin-top:4px}
  .quota{margin-left:auto;text-align:center}
  .quota .num{font-size:22px;font-weight:700;color:var(--primary)}
  .quota .num i{font-style:normal;font-size:12px;color:var(--text-sub)}
  .quota .lbl{font-size:11px;color:var(--text-sub)}
  .my-item{display:flex;align-items:center;border-bottom:1px solid var(--line);padding:11px 2px}
  .my-item:last-child{border-bottom:none}
  .my-item .info{flex:1}
  .my-item .t{font-size:14px;font-weight:600}
  .my-item .d{font-size:11.5px;color:var(--text-sub);margin-top:3px}

  /* 提交条 */
  .submitbar{position:fixed;bottom:56px;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:#fff;border-top:1px solid var(--line);padding:10px 14px;display:flex;align-items:center;gap:12px;z-index:55;box-shadow:0 -2px 8px rgba(0,0,0,.04)}
  .submitbar .txt{font-size:12px;color:var(--text-sub);line-height:1.4}
  .submitbar .txt b{color:var(--primary);font-size:15px}
  .submitbar .btn-main{width:auto;padding:10px 22px;margin:0;flex-shrink:0}

  /* 管理 */
  .admin-row{display:flex;align-items:center;border-bottom:1px solid var(--line);padding:10px 2px;font-size:13px}
  .admin-row:last-child{border-bottom:none}
  .admin-row .s{flex:1;min-width:0}
  .admin-row .s .a{font-weight:600;font-size:13px}
  .admin-row .s .b{font-size:11px;color:var(--text-sub);margin-top:2px}
  .cnt{font-size:13px;font-weight:700;margin-right:10px}
  .cnt.ok{color:var(--green)} .cnt.warn{color:var(--orange)} .cnt.full{color:var(--red)}
  .names{font-size:11px;color:#777;line-height:1.8;margin:4px 0 8px;padding:8px 10px;background:#fafbfc;border-radius:8px}
  .sec-title{font-size:13.5px;font-weight:600;color:#555;margin:4px 2px 8px;display:flex;align-items:center;gap:8px}
  .sec-title .mini{margin-left:auto;font-size:11px;color:var(--primary);font-weight:400}
  .stats{display:flex;gap:10px}
  .stat{flex:1;background:var(--primary-light);border-radius:12px;padding:12px 10px;text-align:center}
  .stat .n{font-size:22px;font-weight:700;color:var(--primary)}
  .stat .l{font-size:11px;color:#6a86a4;margin-top:3px}
  .btn-sm{border:none;border-radius:14px;padding:7px 14px;font-size:12px;cursor:pointer;background:var(--primary);color:#fff;font-family:inherit}
  .btn-sm.gray{background:#eef1f4;color:#5c6b7a}
  .btn-sm.red{background:var(--red-light);color:var(--red)}
  .btn-del{border:none;background:transparent;color:var(--red);font-size:11.5px;padding:6px 8px;cursor:pointer;flex-shrink:0;font-family:inherit}
  .row-flex{display:flex;gap:8px;align-items:center}
  .rec{border-bottom:1px solid var(--line);padding:10px 2px;display:flex;align-items:flex-start;gap:8px}
  .rec:last-child{border-bottom:none}
  .rec .k{font-size:13px;font-weight:600}
  .rec .k .c{font-size:10.5px;background:var(--green-light);color:#2f8a5f;border-radius:4px;padding:2px 6px;margin-left:6px;font-weight:500}
  .rec .v{font-size:11px;color:var(--text-sub);margin-top:3px;line-height:1.7}
  .empty{text-align:center;color:#bbb;font-size:13px;padding:26px 0}

  /* toast & modal */
  .toast{position:fixed;top:38%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.78);color:#fff;font-size:13.5px;padding:12px 22px;border-radius:10px;z-index:200;display:none;max-width:80%;text-align:center;line-height:1.6}
  .mask{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:150;display:flex;align-items:center;justify-content:center;padding:24px}
  .modal{background:#fff;border-radius:16px;width:100%;max-width:340px;padding:20px 18px 16px;text-align:center}
  .modal h3{font-size:16px;margin-bottom:8px}
  .modal p{font-size:13px;color:#666;line-height:1.7;margin-bottom:14px}
  .modal input{width:100%;border:1px solid #ddd;border-radius:9px;padding:10px 12px;font-size:14px;margin-bottom:14px;outline:none;font-family:inherit}
  .modal .btns{display:flex;gap:10px}
  .modal .btns button{flex:1;border:none;border-radius:20px;padding:11px;font-size:14px;cursor:pointer;font-family:inherit}
  .modal .btns .cancel{background:#f0f2f5;color:#666}
  .modal .btns .ok{background:var(--primary);color:#fff}
  .modal .btns .ok.danger{background:var(--red)}
  .modal .btns .ok[disabled]{background:#d5dae0;cursor:not-allowed}
</style>
</head>
<body>
<div class="page">
  <div class="header">
    <h1>万科双语学校 · 六年级开放日</h1>
    <div class="sub">2026年11月20日（周五） · 家长开放日选课系统</div>
